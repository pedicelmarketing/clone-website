# The failed Static Mirror attempt is kept on disk as evidence for the method
# decision, but its payload is not versioned: it is Wix's proprietary
# Thunderbolt runtime plus per-slot media variants, and we deliberately do not
# redistribute the runtime. mirror-manifest.json IS versioned — it is the
# machine-authoritative record of what was attempted, acquired and refused.
mirror/*
!mirror/mirror-manifest.json

# Viewport screenshots — regenerate with the skill's viewports.py
reports/viewports/*.png

# Convenience symlink so v2 is reachable under the v1 tunnel path.
# Serving-only; not part of the deliverable.
site/v2
