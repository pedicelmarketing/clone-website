{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/web-designer/design-plan.schema.json",
  "title": "Web Designer Design Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_slug",
    "generated_at",
    "model",
    "layout_thesis",
    "sections",
    "signature_element",
    "motion_vocabulary",
    "copy_blocks",
    "skipped_sections",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "project_slug": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "description": "Which vendor actually answered (minimax | gemini | anthropic). design_pass.py stamps this before validating, so the schema must accept it \u2014 otherwise every run fails validation on its own provenance field."
    },
    "layout_thesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "audience",
        "job_to_be_done",
        "why_this_not_generic"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "job_to_be_done": {
          "type": "string",
          "minLength": 1
        },
        "why_this_not_generic": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "signature_element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "why_it_fits_brand",
        "implementation_note"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "why_it_fits_brand": {
          "type": "string",
          "minLength": 1
        },
        "implementation_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "motion_vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "register",
        "effects",
        "rationale"
      ],
      "properties": {
        "register": {
          "enum": [
            "restrained",
            "balanced",
            "cinematic"
          ]
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "copy_blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/copyBlock"
      }
    },
    "skipped_sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skipped"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision",
          "alternatives_considered",
          "why_chosen"
        ],
        "properties": {
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "alternatives_considered": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "why_chosen": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "sourceFields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "purpose",
        "component",
        "emphasis",
        "source_brief_fields",
        "rationale",
        "in_nav"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "nav_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "in_nav": {
          "type": "boolean"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "component": {
          "type": "string",
          "minLength": 1
        },
        "emphasis": {
          "enum": [
            "hero",
            "primary",
            "secondary",
            "minor"
          ]
        },
        "layout": {
          "enum": [
            "masthead",
            "split-hero",
            "editorial",
            "feature-split",
            "full-bleed-band",
            "card-grid",
            "proof-row",
            "pull-quote",
            "index-list",
            "cta-band",
            "colophon"
          ],
          "description": "The section's LAYOUT SHAPE \u2014 what it physically looks like. This is the main lever you have over how the page reads, so vary it deliberately; a page where every section uses the same layout is the templated output we are trying to avoid. `emphasis` sets scale/weight, `layout` sets structure. masthead: site header, supplies the wordmark (headline) + tagline (subhead) and is rendered as the page's <header>, not as a body section. split-hero: full-height opening, oversized headline beside the signature element or a photo. editorial: numbered index in a side column, heading + running body beside it. feature-split: photo on one side, text on the other, alternating sides down the page. Needs media. full-bleed-band: photo edge-to-edge across the viewport with a caption. Needs media. card-grid: body split into a grid of short cards (or a grid of photos). proof-row: a compact horizontal row of short proof items \u2014 awards, press, stats. Keep the text short. pull-quote: one oversized statement in a narrow measure; use for a manifesto line or testimonial. index-list: numbered, expandable list \u2014 services, chapters, an FAQ. cta-band: inverted colour band carrying the call to action. Needs a `cta` copy block. colophon: thin monospace strip; rendered inside the page's <footer>."
        },
        "source_brief_fields": {
          "$ref": "#/$defs/sourceFields"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "media": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "description": "Optional brand photograph for this section. MUST reference a file present in the fetched ASSET-MANIFEST.json. Never invent a filename and never point at a stock image \u2014 if no suitable brand photo exists, omit this or set it null and design the section without imagery.",
          "required": [
            "file",
            "alt"
          ],
          "properties": {
            "file": {
              "type": "string",
              "description": "filename from ASSET-MANIFEST.json assets[].file"
            },
            "alt": {
              "type": "string",
              "minLength": 3,
              "description": "real alt text describing the photo (use the asset's subject)"
            },
            "treatment": {
              "type": "string",
              "enum": [
                "full-bleed",
                "inset",
                "side-by-side",
                "grid",
                "background",
                "portrait"
              ],
              "description": "how the image sits in the section's layout"
            },
            "rationale": {
              "type": "string"
            }
          }
        }
      }
    },
    "copyBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "role",
        "text",
        "source_brief_fields"
      ],
      "properties": {
        "section_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "headline",
            "subhead",
            "body",
            "cta",
            "caption"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source_brief_fields": {
          "$ref": "#/$defs/sourceFields"
        }
      }
    },
    "skipped": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reason",
        "missing_brief_fields"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "missing_brief_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
